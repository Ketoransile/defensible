# Copy to .env.local (never commit secrets)

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Demo console gate (shown to judges on /login)
DEMO_ACCESS_CODE=defensible
AUTH_SECRET=change-me-in-production

# MongoDB Atlas (or local). Prefer the connection string from Atlas → Connect.
# On some Windows networks, use Atlas "standard connection string" if SRV DNS fails.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/defensible?retryWrites=true&w=majority
MONGODB_DB=defensible

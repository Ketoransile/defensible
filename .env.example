# Copy to .env.local (never commit secrets)

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Demo console gate (shown to judges on /login)
DEMO_ACCESS_CODE=defensible
AUTH_SECRET=change-me-in-production

# MongoDB — local Docker default, or paste an Atlas URI
MONGODB_URI=mongodb://127.0.0.1:27017/defensible
MONGODB_DB=defensible
